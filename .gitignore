# 📦584 (Loop cleanup) — Prevenir package.json/package-lock.json fantasma en la RAÍZ
# del repo. El proyecto REAL está en sgsst-electron-app/ (4,450 bytes, con
# name/version/build/etc). Si npm install se ejecuta por error desde la raíz,
# crea un package.json minimo (55 bytes) que confunde a npx y electron-builder.
# Estos paths son RELATIVOS a la raíz del repo (con / inicial).
/package.json
/package-lock.json

# Python cache (generado por import chains de debug)
__pycache__/
*.pyc
*.pyo

# Variables de entorno — NUNCA commitear credenciales
# (.env.example SÍ se commitea, .env NO)
.env
.env.local
.env.*.local

# Editor / OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# Herramientas locales de BD (solo dev, no van al repo; clean-dbs BORRA datos)
sgsst-electron-app/firma-service/scripts/clean-dbs.js
sgsst-electron-app/firma-service/scripts/inspect-dbs.js

# 📦 I-AUDIT-2026-09-10 (v0.1.194) · Archive de PDFs huérfanos (cleanup-orphan-pdfs).
# Cuando se ejecuta el script con --yes, mueve PDFs a storage/pdf-archive/<fecha>/
# con su manifest.json. NO van al repo: son evidencia de auditoría que vive en
# disco (Storage/backup) pero no debe contaminar el repo con binarios grandes.
# Si necesitas consultarlos están en storage/pdf-archive/.
sgsst-electron-app/firma-service/storage/pdf-archive/

# 🔒 I-AUDIT-2026-09-10 (v0.1.197) · Backups de DB hechos con clean-gestion-humana.py.
# Cada vez que se hace un cleanup destructivo, se genera un .db + .wal + .shm
# en backups/gestion-humana-clean-<timestamp>/. NO van al repo: son snapshots
# de la DB operativa que existen para restore de emergencia, no son código fuente.
# Si necesitás restaurar, están en backups/gestion-humana-clean-*/.
backups/

# 🗑️ I-AUDIT-2026-09-10 (v0.1.197) · Carpeta temporal para mover archivos que
# shell policies no nos dejan borrar (Remove-Item está bloqueado en este host).
# Cualquier cosa en .trash/ está pendiente de limpieza manual o ya no se necesita.
# NO va al repo.
.trash/

# 📦831 · Residuos de sesión del electron-playwright-cli (pruebas visuales en Chromium).
# Snapshots YAML, outputs de evaluate y screenshots se regeneran en cada sesión.
/sgsst-electron-app/.playwright-cli/
/sgsst-electron-app/.playwright/

# 📦831 · Dependencias locales del CLI de Playwright (12.6 MB, se reinstalan con npm).
/sgsst-electron-app/Temp/pw-deps/

# 📦831 · Planes del agente (directorio de trabajo de la herramienta, no del repo).
/.zcode/
# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
# The **/ prefix covers .impeccable at the repo root or in a nested workspace.
# Shared artifacts stay tracked: config.json, live/config.json,
# design.json, surfaces/*.md, critique/*.md.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png
# impeccable-ignore-end

# Impeccable · engine descargado (16 MB, el launcher lo re-descarga solo si falta)
