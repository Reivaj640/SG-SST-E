{
  "name": "sgsst-electron-app",
  "version": "0.1.38",
  "description": "Sistema de GestiÃ³n de Seguridad y Salud en el Trabajo",
  "main": "main.js",
  "author": "Javier Robles F. Prof. SG-SST - Esp. Gerencia de Proyectos.",
  "scripts": {
    "start": "electron .",
    "debug": "electron debug-app.js",
    "debug-main": "electron debug-main.js",
    "debug-full": "electron debug-full.js",
    "dev": "nodemon --exec electron . --watch ./",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "dist": "electron-builder",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "docs:generate": "jsdoc -c jsdoc.json",
    "docs:watch": "nodemon --watch . --ext js --exec \"jsdoc -c jsdoc.json\""
  },
  "build": {
    "appId": "com.jrfsoluciones.sgsst",
    "productName": "SG-SST Electron App",
    "copyright": "Copyright Â© 2025 Javier Robles F. Prof. SG-SST - Esp. Gerencia de Proyectos.",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!Instructivo-Submodulos.txt",
      "!Portear/.venv/**",
      "!Portear/__pycache__/**"
    ],
    "extraResources": [
      {
        "from": "Portear/src",
        "to": "python-scripts",
        "filter": [
          "**/*.py"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/Blanco.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/Blanco.icns",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/Blanco.png",
      "category": "Business"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Reivaj640",
        "repo": "SG-SST-E",
        "private": false,
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "conventional-changelog-cli": "^5.0.0",
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12",
    "ink-docstrap": "^1.3.2",
    "jsdoc": "^4.0.5",
    "minami": "^1.2.3",
    "nodemon": "^3.1.10"
  },
  "dependencies": {
    "core-util-is": "^1.0.3",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "vanilla-calendar-pro": "^3.0.5",
    "xlsx": "^0.18.5"
  }
}
