# =============================================================================
# Servicio de Firma Electrónica K+AIR v1 — PRODUCCIÓN (VM)
# =============================================================================
# En la VM: copiar a /opt/kair-firma/.env y completar los valores.
# NUNCA commitear el .env real. NUNCA reutilizar las keys de desarrollo.
# =============================================================================

# --- Servidor ---
PORT=3001
# Interfaz de escucha. 127.0.0.1 = solo local (lo correcto: el tunel de
# Cloudflare se conecta ahi). Poner 0.0.0.0 solo si hay firewall delante.
HOST=127.0.0.1
NODE_ENV=production
# URL pública CON HTTPS definitiva. Debe coincidir con el dominio configurado
# en Caddy. Con sslip.io (sin comprar dominio):
#   PUBLIC_URL=https://firma.<IP-DE-LA-VM-con-guiones>.sslip.io
# Ej: PUBLIC_URL=https://firma.152-67-33-10.sslip.io
# Cuando migres a dominio propio, cambiar aquí y en el Caddyfile (los enlaces
# ya enviados por correo NO cambian: hay que mandar invitaciones nuevas).
PUBLIC_URL=https://CAMBIAR-ME.sslip.io

# --- Base de datos (ruta absoluta en la VM) ---
DB_PATH=/opt/kair-firma/data/firma.sqlite

# --- Autenticación API interna (la que K+AIR usa por empresa) ---
# GENERAR NUEVA en la VM (no copiar la de desarrollo):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nota: con clientes per-empresa (gh_internal_clients) esta key legacy queda
# como respaldo; las operaciones de empresa usan su API key propia.
INTERNAL_API_KEY=generar-nueva-en-la-vm-64-chars-hex

# --- Autenticación API administrativa (solo operador humano) ---
# GENERAR NUEVA en la VM. K+AIR NO la guarda; la usas tú con curl/scripts
# para crear clientes per-empresa y versiones del acuerdo.
ADMIN_API_KEY=generar-nueva-en-la-vm-64-chars-hex

# --- El actor de los actos administrativos (P7, 10-nov-2026) ---
# QUIEN hace el acto, con nombre y apellido. El service lo lee de la cabecera
# `X-Admin-Actor`; este valor es el respaldo que usan el preflight y las
# llamadas administrativas hechas desde esta maquina.
#
# POR QUE TIENE QUE SER UN NOMBRE DE PERSONA: la contrafirma de un Anexo EXIGE
# acreditar la facultad de quien la hace. Si el actor no es el representante
# legal de Gesstiar, tiene que haber un poder acreditado a su nombre; si no
# hay, el service responde 409 FACULTAD_NO_ACREDITADA y el acto NO se cierra.
# Un valor como "K+AIR usuario@EQUIPO" identifica la maquina, no a una
# persona, y por lo tanto no acredita nada.
#
# DECISION DEL OWNER (10-nov-2026): quien contrafirma por Gesstiar es el
# representante legal, Javier Robles Fontalvo. No hace falta registrar ningun
# poder para ese nombre.
FIRMA_ADMIN_ACTOR=Javier Robles Fontalvo

# --- Trust proxy ---
# Caddy corre en la MISMA VM y se conecta por 127.0.0.1 → 'loopback' es
# correcto y SEGURO: Express confiará en X-Forwarded-For del proxy local,
# así la trazabilidad registra la IP REAL del firmante (celular, PC remoto),
# no la del proxy. No usar 'true' (permitiría falsificar la IP).
TRUST_PROXY=loopback

# --- SMTP (correo de invitaciones) ---
# La cuenta TRANSACCIONAL del servicio es de Google Workspace, con el Cloud
# Data Processing Addendum (CDPA) incorporado al Acuerdo: por eso el papel del
# proveedor es el de Subencargado de los datos del servicio de correo.
# Decision A del 9-nov-2026 (docs/gestion-humana/firma-electronica/).
#
# La contrasena es el App Password de Google, NO la clave normal. Si la consola
# de Workspace tiene DESHABILITADAS las app passwords, esta opcion no sirve:
# hay que migrar a OAuth2 (cambio en src/services/mailer.js) o a un SMTP relay.
# La decision la toma el owner mirando el panel (pendiente P2).
#
# SMTP_USER y SMTP_FROM_EMAIL son la IDENTIDAD DE ENVIO (codigo OTP, enlace de
# acceso a la solicitud de firma, avisos del procedimiento e invitacion a
# suscribir el Anexo de Nube). Los canales de derechos, PQRS e incidentes NO
# se cambian con esta migracion: siguen en los buzones actuales porque los
# alias de Workspace no estan verificados. La excepcion esta escrita en el
# manifiesto (bloque `canales`) y en la Decision A, apartado 3.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kair@gesstiar.com
SMTP_PASS=pegar-app-password-aqui
SMTP_FROM_NAME=K+AIR Firma Electrónica
SMTP_FROM_EMAIL=kair@gesstiar.com

# --- Tiempos (valores saneados de desarrollo; dejar igual) ---
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
TOKEN_TTL_HOURS_REMOTE=72
TOKEN_TTL_HOURS_PRESENCIAL=24

# --- Rate limiting público (por IP) ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_OTP_PER_HOUR=10
RATE_LIMIT_COMMIT_PER_MINUTE=3
RATE_LIMIT_SIGN_REQUEST_PER_MINUTE=30

# --- Email reintentos ---
EMAIL_RETRY_DELAYS_MIN=5,30,120
EMAIL_RETRY_MAX_ATTEMPTS=3

# --- Almacenamiento de PDFs (ruta absoluta en la VM) ---
PDF_STORAGE_PATH=/opt/kair-firma/storage/pdfs
PUBLIC_URL_FIRMA=https://CAMBIAR-ME.sslip.io
