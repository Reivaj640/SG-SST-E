# =============================================================================
# Servicio de Firma Electrónica K+AIR v1 — PRODUCCIÓN (VM)
# =============================================================================
# En la VM: copiar a /opt/kair-firma/.env y completar los valores.
# NUNCA commitear el .env real. NUNCA reutilizar las keys de desarrollo.
# =============================================================================

# --- Servidor ---
PORT=3001
NODE_ENV=production
# URL pública CON HTTPS definitiva. Debe coincidir con el dominio configurado
# en Caddy. Con sslip.io (sin comprar dominio):
#   PUBLIC_URL=https://firma.<IP-DE-LA-VM-con-guiones>.sslip.io
# Ej: PUBLIC_URL=https://firma.152-67-33-10.sslip.io
# Cuando migres a dominio propio, cambiar aquí y en el Caddyfile (los enlaces
# ya enviados por correo NO cambian: hay que mandar invitaciones nuevas).
PUBLIC_URL=https://CAMBIAR-ME.sslip.io

# --- Base de datos (ruta absoluta en la VM) ---
DB_PATH=/opt/kair-firma/data/firma.sqlite

# --- Autenticación API interna (la que K+AIR usa por empresa) ---
# GENERAR NUEVA en la VM (no copiar la de desarrollo):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nota: con clientes per-empresa (gh_internal_clients) esta key legacy queda
# como respaldo; las operaciones de empresa usan su API key propia.
INTERNAL_API_KEY=generar-nueva-en-la-vm-64-chars-hex

# --- Autenticación API administrativa (solo operador humano) ---
# GENERAR NUEVA en la VM. K+AIR NO la guarda; la usas tú con curl/scripts
# para crear clientes per-empresa y versiones del acuerdo.
ADMIN_API_KEY=generar-nueva-en-la-vm-64-chars-hex

# --- Trust proxy ---
# Caddy corre en la MISMA VM y se conecta por 127.0.0.1 → 'loopback' es
# correcto y SEGURO: Express confiará en X-Forwarded-For del proxy local,
# así la trazabilidad registra la IP REAL del firmante (celular, PC remoto),
# no la del proxy. No usar 'true' (permitiría falsificar la IP).
TRUST_PROXY=loopback

# --- SMTP (correo de invitaciones) ---
# MISMA cuenta Gmail validada en desarrollo (adminkair@gmail.com) o la
# definitiva. La contraseña es el App Password de Google, NO la clave normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=adminkair@gmail.com
SMTP_PASS=pegar-app-password-aqui
SMTP_FROM_NAME=K+AIR Firma Electrónica
SMTP_FROM_EMAIL=adminkair@gmail.com

# --- Tiempos (valores saneados de desarrollo; dejar igual) ---
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
TOKEN_TTL_HOURS_REMOTE=72
TOKEN_TTL_HOURS_PRESENCIAL=24

# --- Rate limiting público (por IP) ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_OTP_PER_HOUR=10
RATE_LIMIT_COMMIT_PER_MINUTE=3
RATE_LIMIT_SIGN_REQUEST_PER_MINUTE=30

# --- Email reintentos ---
EMAIL_RETRY_DELAYS_MIN=5,30,120
EMAIL_RETRY_MAX_ATTEMPTS=3

# --- Almacenamiento de PDFs (ruta absoluta en la VM) ---
PDF_STORAGE_PATH=/opt/kair-firma/storage/pdfs
PUBLIC_URL_FIRMA=https://CAMBIAR-ME.sslip.io
