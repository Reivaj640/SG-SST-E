# =============================================================================
# Servicio de Firma Electrónica K+AIR v1 — Configuración
# =============================================================================
# Copiar este archivo a `.env` y completar los valores reales.
# NUNCA commitear `.env` (está en .gitignore).
# =============================================================================

# --- Servidor ---
PORT=3001
NODE_ENV=development
PUBLIC_URL=http://localhost:3001

# --- Base de datos ---
DB_PATH=./data/firma.sqlite

# --- Criptografía ---
# Llave MAESTRA de 32 bytes en hexadecimal (64 caracteres). En producción es
# OBLIGATORIA: el servicio no arranca sin ella. De aquí se derivan el cifrado
# AES-256-GCM y las claves HMAC. NO se cambia sin rotar el anillo.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# En desarrollo puede quedar vacía: se usa data/.dev-master-key (solo local).
TOKEN_ENCRYPTION_KEY=

# Anillo opcional para rotar las claves HMAC sin invalidar la evidencia vieja.
# Si no se define, se usa { "k1": TOKEN_ENCRYPTION_KEY }.
# FIRMA_HMAC_KEYRING={"k1":"<64 hex>","k2":"<64 hex>"}
# FIRMA_HMAC_KEY_VERSION=k2

# --- Autenticación API interna ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=cambiar-en-produccion-32-bytes-minimo

# --- D-03: la Empresa debe estar habilitada para pedir firmas ---
# Una empresa REGISTRADA necesita Anexo de Encargo firmado y plazo de
# conservación declarado; si falta alguno, la creación de la solicitud de
# firma se rechaza con 409 EMPRESA_NO_HABILITADA.
#
# EL BLOQUEO ES INCONDICIONAL. La bandera FIRMA_EXIGIR_HABILITACION_EMPRESA se
# RETIRÓ (📦933): con ella en 'false' la firma pasaba y solo quedaba un WARN,
# o sea un "if silencioso" que no deja rastro de quién lo apagó. La única
# salida del bloqueo es la EXCEPCIÓN auditable:
#   POST /internal/admin/excepciones-habilitacion
# (autorización escrita, alcance de 1 Empresa + N firmas, ruta en papel
# operativa, plazo máximo de 30 días, bitácora inmutable y piloto autorizado).
#
# Si tu .env todavía tiene la variable, es INERTE: no hace nada y no hay que
# quitarla. Para saber qué Empresas están sin habilitar:
#   node scripts/inventario-empresas-no-habilitadas.js

# --- Canales de K+AIR (Gesstiar S.A.S.) ---
# Son DOS canales distintos y ambos se publican en la mini-app y en el correo
# de invitación:
#
#   - FIRMA_CANAL_INCIDENCIAS: el 5.1(c). Para avisar que se comprometieron
#     los datos de creación de la firma (el OTP y el enlace).
#   - FIRMA_CANAL_PROTECCION_DATOS: el 10.7(b). Para ejercer los derechos
#     del Titular. K+AIR los recibe, los registra y los trasmite a la
#     Empresa, que es la Responsable y la que responde.
#
# ⚠️ Los dos tienen que ser buzones REALES y monitoreados antes de
# publicar la v1.1.
FIRMA_CANAL_INCIDENCIAS=adminkair@gmail.com
FIRMA_CANAL_PROTECCION_DATOS=privacidad.kair@gmail.com

# --- El plazo de trasmisión de una solicitud de derechos a la Empresa ---
# En días HÁBILES. Lo define la política, no el código: si el abogado pone
# otro número, se cambia acá.
FIRMA_PLAZO_TRAMITE_DIAS=2

# --- D-2: el OTP (dato de creación de la firma) va a un medio PERSONAL ---
# El código de verificación NO puede llegar a un buzón que la Empresa
# pueda leer: el 2.2.2.47.4 núm. 1 exige que los datos de creación de la firma
# correspondan exclusivamente al firmante.
#
# false (default) = APAGADO. El flujo sigue como hoy: si el Trabajador no declara
# un medio personal, el código va al contacto registrado por la Empresa, pero cada
# caso queda en el log como WARN (OTP_MEDIO_CORPORATIVO). De ahí sale el número:
#   node scripts/inventario-buzon-corporativo.js
#
# true = ENCENDIDO. Un buzón corporativo da 400 con el texto del 3.7(a) al lado
# (MEDIO_OTP_CORPORATIVO) y se ofrece la firma en papel (7.2).
#
# ⚠️ NO lo enciendas hasta que exista la 9A (la firma en papel): sin esa salida,
# exigir un medio personal sería una barrera de acceso al empleo (2.2.1.1.11).
FIRMA_EXIGIR_MEDIO_PERSONAL_OTP=false

# --- Autenticación API administrativa ---
# DISTINTA de INTERNAL_API_KEY. K+AIR NO debe tener esta key.
# Solo operadores humanos con acceso físico al servidor la usan para
# publicar/gestionar versiones del Acuerdo de uso (POST /internal/admin/acuerdo-versiones).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=cambiar-en-produccion-admin-32-bytes-min

# --- Trust proxy (P1-6) ---
# Configura app.set('trust proxy', N) en Express.
# POR SEGURIDAD: NO usar 'true' (permite spoofing de X-Forwarded-For y
# bypass de rate limit). Ver src/middleware/rateLimit.js.
#   'loopback'      → solo 127.0.0.1, ::1 (dev sin proxy)
#   '1'             → último hop (típico: cloudflare + nginx local)
#   '10.0.0.0/8'    → CIDR privada
#   '<nginx-ip>'    → IP específica del proxy reverso
TRUST_PROXY=loopback

# --- SMTP (correo) ---
# En desarrollo se puede usar Mailtrap, MailHog, o cuenta Gmail con App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cambiar@gmail.com
SMTP_PASS=cambiar-app-password
SMTP_FROM_NAME=K+AIR Firma Electrónica
SMTP_FROM_EMAIL=no-reply@k-air.com

# --- Tiempos ---
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
TOKEN_TTL_HOURS_REMOTE=72
TOKEN_TTL_HOURS_PRESENCIAL=24

# --- Rate limiting (público por IP) ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_OTP_PER_HOUR=10
RATE_LIMIT_COMMIT_PER_MINUTE=3
RATE_LIMIT_SIGN_REQUEST_PER_MINUTE=30

# --- Email reintentos (Gap 3) ---
EMAIL_RETRY_DELAYS_MIN=5,30,120
EMAIL_RETRY_MAX_ATTEMPTS=3

# --- Almacenamiento ---
PDF_STORAGE_PATH=./storage/pdfs
PUBLIC_URL_FIRMA=https://firma.k-air.com
