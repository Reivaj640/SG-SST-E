# =============================================================================
# Servicio de Firma Electrónica K+AIR v1 — Configuración
# =============================================================================
# Copiar este archivo a `.env` y completar los valores reales.
# NUNCA commitear `.env` (está en .gitignore).
# =============================================================================

# --- Servidor ---
PORT=3001
NODE_ENV=development
PUBLIC_URL=http://localhost:3001

# --- Base de datos ---
DB_PATH=./data/firma.sqlite

# --- Autenticación API interna ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=cambiar-en-produccion-32-bytes-minimo

# --- SMTP (correo) ---
# En desarrollo se puede usar Mailtrap, MailHog, o cuenta Gmail con App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cambiar@gmail.com
SMTP_PASS=cambiar-app-password
SMTP_FROM_NAME=K+AIR Firma Electrónica
SMTP_FROM_EMAIL=no-reply@k-air.com

# --- Tiempos ---
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
TOKEN_TTL_HOURS_REMOTE=72
TOKEN_TTL_HOURS_PRESENCIAL=24

# --- Rate limiting (público por IP) ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_OTP_PER_HOUR=10
RATE_LIMIT_COMMIT_PER_MINUTE=3

# --- Email reintentos (Gap 3) ---
EMAIL_RETRY_DELAYS_MIN=5,30,120
EMAIL_RETRY_MAX_ATTEMPTS=3

# --- Almacenamiento ---
PDF_STORAGE_PATH=./storage/pdfs
PUBLIC_URL_FIRMA=https://firma.k-air.com
